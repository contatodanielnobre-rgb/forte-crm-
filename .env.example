DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forte_crm"
AUTH_SECRET="troque-esta-chave-por-uma-aleatoria-longa"
# Opcional em produção (Vercel Blob). Sem token, anexos vão para ./uploads
BLOB_READ_WRITE_TOKEN=""
# Fuso horário usado para datas/horários no servidor (TZ é reservada na Vercel; use APP_TZ)
APP_TZ="America/Fortaleza"

# ── SALES COP AI ──
# IA (OpenAI). Sem a chave o agente funciona apenas com as regras de fiscalização.
OPENAI_API_KEY=""
# Segredo das rotinas automáticas (/api/salescop/routine). Vercel Cron envia Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=""
# WhatsApp Business Cloud API (Meta). Sem credenciais o envio fica bloqueado (nada é simulado).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
# Opcional: template aprovado (1 parâmetro de texto) para iniciar conversas fora da janela de 24h
WHATSAPP_TEMPLATE_DAILY=""
